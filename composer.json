{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.0",
        "filament/spatie-laravel-media-library-plugin": "^4.0",
        "laravel/framework": "^13.7",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "mailersend/laravel-driver": "^3.2",
        "mpdf/mpdf": "^8.3",
        "openspout/openspout": "^4.32",
        "sentry/sentry-laravel": "^4.27",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-medialibrary": "^11.22",
        "spatie/laravel-permission": "^7.4",
        "spatie/laravel-settings": "^3.8",
        "stephenjude/filament-two-factor-authentication": "^4.0"
    },
    "require-dev": {
        "brianium/paratest": "^7.20",
        "dedoc/scramble": "^0.13.30",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --no-progress"
        ],
        "api-spec": [
            "@php artisan api:export-spec"
        ],
        "lint": [
            "vendor/bin/pint --test"
        ],
        "lint-dirty": [
            "vendor/bin/pint --test --dirty"
        ],
        "lint-fix": [
            "vendor/bin/pint"
        ],
        "lint-fix-dirty": [
            "vendor/bin/pint --dirty"
        ],
        "qa": [
            "@analyse",
            "vendor/bin/pest --parallel"
        ],
        "coverage": [
            "Composer\\Config::disableProcessTimeout",
            "herd coverage -dzend_extension=/Applications/Herd.app/Contents/Resources/xdebug/xdebug-84-arm64.so -dxdebug.mode=coverage vendor/bin/pest --coverage"
        ],
        "coverage-html": [
            "Composer\\Config::disableProcessTimeout",
            "herd coverage -dzend_extension=/Applications/Herd.app/Contents/Resources/xdebug/xdebug-84-arm64.so -dxdebug.mode=coverage vendor/bin/pest --coverage --coverage-html=coverage"
        ],
        "e2e-coverage": [
            "Composer\\Config::disableProcessTimeout",
            "scripts/e2e-coverage.sh"
        ],
        "coverage-all": [
            "Composer\\Config::disableProcessTimeout",
            "scripts/coverage-all.sh"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
