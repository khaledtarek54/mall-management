<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <!--
                Filament declarative UI scaffolding — Pages, Schemas, Tables,
                Infolists, RelationManagers, Exporters, Importers. These are
                config-only classes; behavior is exercised by tests/e2e/*.spec.js.
                Resource.php files stay in scope because they hold business logic
                (getEloquentQuery, navigation gating, etc.).
            -->
            <directory>app/Filament/*/Resources/*/Pages</directory>
            <directory>app/Filament/*/Resources/*/Schemas</directory>
            <directory>app/Filament/*/Resources/*/Tables</directory>
            <directory>app/Filament/*/Resources/*/RelationManagers</directory>
            <directory>app/Filament/*/RelationManagers</directory>
            <directory>app/Filament/Exports</directory>
            <directory>app/Filament/Imports</directory>

            <!-- Settings data classes — public typed properties only. -->
            <directory>app/Settings</directory>

            <!-- Service-provider bootstrap (panel registration). -->
            <directory>app/Providers</directory>

            <!-- Filament admin Pages that are pure UI shells (the Reports / AR
                 Aging pages just delegate to ReportService, which IS covered). -->
            <file>app/Filament/Admin/Pages/Settings.php</file>
            <file>app/Filament/Admin/Pages/OccupancyMap.php</file>
            <file>app/Filament/Admin/Pages/Tenancy/RegisterProperty.php</file>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!-- Keep the owner panel registered under test so its coverage runs. -->
        <env name="OWNER_PORTAL_ENABLED" value="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
