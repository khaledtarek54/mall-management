{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && npm run docs:build",
        "dev": "vite",
        "docs:data": "php artisan atriom:dump-handbook-data",
        "docs:dev": "npm run docs:data && vitepress dev docs/visual",
        "docs:build": "npm run docs:data && vitepress build docs/visual",
        "docs:preview": "vitepress preview docs/visual"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@playwright/test": "^1.60.0",
        "@tailwindcss/vite": "^4.3.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.3.0",
        "vite": "^8.0.0",
        "vitepress": "^1.6.4"
    }
}
