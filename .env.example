APP_NAME=Atriom
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# PRODUCTION: APP_ENV=production · APP_DEBUG=false · APP_URL=https://...
# Scheduled jobs fire on this timezone — set Africa/Cairo in production.
# A MONEY setting, not a display one: it decides which day — and which accounting period —
# a document belongs to. Under UTC, anything created after ~21:00 Cairo is attributed to
# the previous day. Leave this as Africa/Cairo unless the operator is not in Egypt.
APP_TIMEZONE=Africa/Cairo

# Demo / pilot password used by DemoSeeder for every seeded user
# (admin / manager / viewer / leasing / maintenance + first 3 portal
# tenants). Leave as 'password' for dev + CI. PRODUCTION / pilot
# environments must override this before exposing the URL.
DEMO_USER_PASSWORD=password

# Where the MOBILE password-reset email points. Unset, it falls back to
# APP_URL/reset-password — a route this application does not have, so the
# tenant receives a mail whose only button 404s. Set it to the app deep link
# (atriom://reset-password) or an https page that completes
# POST /api/v1/auth/reset-password. `atriom:health` FAILS in production while
# this is unset. NOTE: this is the Tenant (company) reset used by the mobile
# API — the /portal reset is a separate TenantUser flow and needs nothing here.
# APP_MOBILE_RESET_URL=

# Demo payments — the "mark it paid, no gateway" shortcut used to show the
# portal and the mobile app end to end. It writes a REAL captured payment
# (Dr Bank / Cr AR) for money that never arrived, so:
#   unset      = follow the environment (on in local/testing, off elsewhere)
#   true       = explicit opt-in, for a demo box only — NEVER staging or prod
# Production refuses it outright regardless, and `atriom:health` FAILS if the
# flag is set there. On STAGING nothing overrides the flag — the shortcut is
# genuinely live — so health FAILS there too while it is set (2026-08-16).
# Owner: App\Support\DemoPayments. See docs/STAGING.md §2.
# DEMO_PAYMENTS_ENABLED=

# Paymob integration. Disabled by default — flip PAYMOB_ENABLED=true once
# the 4 credentials below are populated. See PAYMOB-SETUP.md for the
# step-by-step credential acquisition guide.
# NOTE: this flag is NOT a safety gate for the demo shortcut above. It used to
# be the only one, which meant the shortcut was live precisely on a production
# box with no gateway configured — the shipped default.
PAYMOB_ENABLED=false
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
# Only while rotating the HMAC secret — see docs/integrations/PAYMOB-SETUP.md §7.
# Both must be EMPTY in normal operation: `atriom:health` fails in production if the previous
# secret is still set once its window has closed.
PAYMOB_HMAC_SECRET_PREVIOUS=
PAYMOB_HMAC_PREVIOUS_UNTIL=
PAYMOB_CURRENCY=EGP
# Two simultaneous taps on Pay must not open two gateway orders for one invoice:
# session creation is serialised per invoice+channel. Defaults are fine.
PAYMOB_SESSION_LOCK_SECONDS=30
PAYMOB_SESSION_LOCK_WAIT_SECONDS=10
# Apple Pay is a SEPARATE Paymob integration + needs a verified domain.
# Leave empty to hide the Apple Pay button. See docs/PAYMENT-LINK-APPLEPAY.md.
PAYMOB_APPLE_PAY_INTEGRATION_ID=

# Deep link that opens the tenant mobile app from the public payment status
# page (e.g. atriom://invoices). Empty = the "Open the app" button is hidden.
APP_DEEP_LINK=

# ETA e-invoicing (Egyptian Tax Authority). Runs in MOCK mode until real
# credentials land — flip ETA_MOCK=false to hit ETA's preprod, then production.
# Verify creds anytime with: php artisan integrations:check --eta
# See docs/modules/16-eta-einvoicing.md + docs/ETA-PAYMOB-CERTIFICATION.md.
ETA_ENABLED=true
ETA_MOCK=true
ETA_ENDPOINT=https://api.preprod.invoicing.eta.gov.eg
ETA_AUTH_ENDPOINT=https://id.preprod.eta.gov.eg/connect/token
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=
# Operator (issuer) identity — replace the demo values before live submission.
ETA_ISSUER_TRN=100000000
ETA_ISSUER_TYPE=B
ETA_ISSUER_NAME="Atriom Demo Operator"
ETA_ISSUER_COUNTRY=EG
ETA_ISSUER_GOVERNATE=Giza
ETA_ISSUER_CITY="6th of October City"
ETA_ISSUER_STREET="Wahat Road"
ETA_ISSUER_BUILDING=1
# Registered EGS item codes per charge type (placeholders until ETA issues them).
ETA_EGS_BASE_RENT=EG-6820-001
ETA_EGS_SERVICE_CHARGE=EG-6820-002
ETA_EGS_UTILITY=EG-3530-001
ETA_EGS_PARKING=EG-5221-001
ETA_EGS_PERCENTAGE_RENT=EG-6820-003
ETA_EGS_DEFAULT=EG-6820-999
# Document signing (CAdES) — REQUIRED for ETA production. Keep off for preprod.
ETA_SIGNING_ENABLED=false
ETA_CERTIFICATE_PATH=
ETA_PRIVATE_KEY_PATH=

# Late-fee policy — SEEDS the initial settings row on a FRESH install only.
# After the first `php artisan migrate`, the live values are Settings → Billing
# (and per property at /admin/property-overrides). Changing these later does
# nothing: nothing reads them at run time.
# LATE_FEE_PERCENT=2.0
# LATE_FEE_GRACE_DAYS=7
# LATE_FEE_MINIMUM=50.00

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# `daily`, not `single`. This is the file production actually copies, so pinning `single`
# here defeats the safe default in config/logging.php: `single` appends to one
# storage/logs/laravel.log forever and never prunes, and a full disk stops the app
# (MySQL, sessions and uploads all lose their writes) rather than merely slowing it.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# The DEFAULTS are now the production-safe ones (config/logging.php): the `stack` channel
# resolves to `daily`, which rotates and prunes to LOG_DAILY_DAYS=14, and the level is
# `info`. Laravel's stock `single` channel appends to one file forever — on a live box that
# fills the disk, and a full disk stops the app rather than slowing it.
#
# (The old note here claimed debug "leaks SQL/PII". It does not: nothing in this codebase
# enables query logging — no DB::listen, no Telescope, no debugbar. The real risk was the
# unbounded file, which is what changed.)
#
# debug is set below for LOCAL convenience only; leave it unset in production.
LOG_LEVEL=debug
# Operational log (money/integration paths via App\Support\OpsLog → 'ops' channel).
#
# PRODUCTION — do this, it is the single highest-leverage ops change available:
#   OPS_LOG_STACK="ops_daily,slack"
#   LOG_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Until then EVERY "we log it loudly" path — failed ETA submissions, exhausted job retries,
# Paymob outages, unassessed SLA penalties, ledger-sync failures — lands in a local file
# that is only visible to someone SSH'd into the box.
OPS_LOG_STACK=ops_daily
OPS_LOG_LEVEL=info
# DISCORD works through the `slack` channel unchanged — append `/slack` to the webhook URL and
# Discord accepts Slack-format payloads. So this needs no Discord-specific logging code:
#   OPS_LOG_STACK="ops_daily,slack"
#   LOG_SLACK_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>/slack
# Without the /slack suffix Discord answers 400 and every alert is silently dropped.
# Alerting threshold, independent of LOG_LEVEL on purpose (LOG_LEVEL tunes app-log
# verbosity; this decides what is worth waking someone for). `error` = OpsLog's
# "money did not move". Raise to `critical` if it gets noisy — don't tune LOG_LEVEL.
LOG_SLACK_LEVEL=error

# Error tracking (Sentry). EMPTY = completely inert: no network calls, no cost — the SDK
# skips the send when there is no DSN. Set this in production and unhandled 500s, exhausted
# queue jobs and Paymob/ETA failures get a grouped stack trace instead of a customer
# complaint. Complements OpsLog: OpsLog reports the failures we anticipated, Sentry the ones
# we didn't.
#
# PII is withheld by config/sentry.php (send_default_pii=false + a before_send that reuses
# OpsLog's redaction). Do NOT set SENTRY_SEND_DEFAULT_PII=true — this system holds tax IDs,
# lease terms and payment data. Sentry is self-hostable if Eltizam needs the data in-country.
SENTRY_LARAVEL_DSN=
#
# REFUSALS ARE EXCLUDED. `DomainException` is this app's refusal mechanism — 139 throw sites, every
# one the system correctly declining something the operator asked for. Laravel's internal
# don't-report list does NOT cover it, so bootstrap/app.php adds `dontReport(DomainException)`.
# Without that, every refusal arrives as an error and the failures nobody anticipated — the reason
# Sentry is here at all — are buried under the system working as designed.
#
# Issues reach Discord through Sentry's OWN Discord integration plus an alert rule, not a webhook:
# Sentry's webhook payload is not a format Discord accepts. Set that up in Sentry, not here.
#
# Performance tracing: 0.1 = sample 10% of requests. COMMENT THE LINE OUT to disable — an EMPTY
# value casts to 0.0, which enables tracing at a 0% sample rather than switching it off.
# SENTRY_TRACES_SAMPLE_RATE=

# Mobile token lifetime in minutes (default 30 days). Sanctum.
SANCTUM_TOKEN_EXPIRATION=43200
# Two-factor enforcement. OPT-IN: empty (or absent) = nobody is forced through TOTP setup.
# Switching it on marches every listed role through enrolment at their NEXT login, so turn it on
# when the operator has scheduled that with staff — not on a deploy nobody planned.
# `php artisan atriom:health` FAILS on a production deploy that leaves this empty.
# The recommended production value (every role that can move money or change a tenancy):
#   # Cloudflare Turnstile on the ADMIN sign-in form. OFF unless BOTH are set — which is what
# keeps the test suite and every unconfigured box working, and is also the emergency escape
# hatch: clear them, re-run config:cache, and the panel is loginable again with no deploy.
# It fails CLOSED (an unreachable Turnstile refuses the sign-in), because failing open would
# let anyone who can block one outbound request switch the protection off. Create the widget
# at Cloudflare → Turnstile; the domain must match the host the panel is served on.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

SECURITY_FORCE_2FA_ROLES="super_admin,mall_admin,manager,accounting,leasing,operations,coordinator,hr,marketing"
SECURITY_FORCE_2FA_ROLES=

# Generate https:// absolute URLs. These are the URLs that LEAVE the building — the tenant
# payment link, password resets, the Paymob return URL, the button in an emailed alert — and TLS
# terminates at the proxy, so PHP sees plain http and would build them all as http://.
# Defaults ON outside local/testing; set explicitly only to override.
# FORCE_HTTPS=true
#
# Which proxies to trust for X-Forwarded-* (client IP + original scheme). Defaults to "*", which
# is safe ONLY while the app is unreachable except through the proxy: exposed directly, a caller
# could forge X-Forwarded-For and escape login throttling. Pin it if the app is ever public.
# TRUSTED_PROXIES=10.0.0.1,10.0.0.2

# Which BROWSER origins may call /api/* and sanctum/csrf-cookie. Comma-separated.
# Empty (the default) means this application's own origin only, derived from APP_URL —
# correct for the panel, the portal and the native mobile app, which send no Origin header
# at all and are therefore unaffected by CORS entirely.
# Add an origin only when a real browser client needs it (e.g. a web front-end for the
# public shopper feed). Never `*`: atriom:health FAILS a deployed box that allows any origin.
# CORS_ALLOWED_ORIGINS=https://shop.example,https://admin.example
# Export job connection. 'sync' = in-request (no worker needed). PRODUCTION with
# a queue worker: set to 'database' so large CSV/Excel exports don't time out.
EXPORT_QUEUE_CONNECTION=sync

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# CA certificate for a MANAGED MySQL that requires TLS (Aiven, DigitalOcean). An ABSOLUTE path.
# config/database.php wires this into the PDO options through array_filter, so an EMPTY value is
# DROPPED and PDO connects WITHOUT SSL — the managed provider then rejects the handshake and the
# box cannot reach its own database. There is no partial state: it either connects with TLS or not
# at all. Irrelevant while MySQL is on the same box (INFRASTRUCTURE.md §2, phase 1); required the
# moment it moves off-box. See docs/operations/INFRASTRUCTURE.md §6.
# MYSQL_ATTR_SSL_CA=/var/www/atriom-prod/current/storage/certs/aiven-ca.pem

# Where `mysqldump` lives, if it is not on PATH. A DIRECTORY, not the binary.
#
# `backup:run` shells out to it: no binary, exit 127, and the nightly job writes NOTHING while
# still looking scheduled. That happened here for nineteen days. Leave EMPTY on any image that
# installs the MySQL client normally — the PATH lookup is correct there, and the deploy image
# shipping the client is the real requirement. Set it when the client is installed somewhere the
# shell will not find: Homebrew's `mysql-client` is keg-only, so a Mac needs
#   DB_DUMP_BINARY_PATH=/opt/homebrew/opt/mysql-client/bin
# (the stable opt symlink, NOT the versioned Cellar path, which brew upgrades away).
# `atriom:health` reports `backup_capability` and FAILS in production when no binary is reachable.
# DB_DUMP_BINARY_PATH=

# PRODUCTION: these three must be `redis` (docs/INFRASTRUCTURE.md §5). MySQL is
# off-box there, so on `database` every session read/write, every permission-
# catalogue read, every queue poll and EVERY Cache::lock() crosses the network —
# and the monthly-billing double-bill guard IS a cache lock, with no unique index
# behind it. `atriom:health` FAILS in production while any of them is `database`.
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Session payloads are encrypted at rest by DEFAULT on any deployed environment
# (anything that is not local/testing) — see config/session.php. Leave this line
# commented out: setting it here would override that default, and a deploy copies
# this file. That is exactly how LOG_STACK=single defeated the safe log channel.
# Set it explicitly only to turn encryption OFF, and only with a reason.
# SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Redis KEYSPACE separation. Only matters once two environments share one Redis server — which is
# exactly what INFRASTRUCTURE.md §3 does when production joins the staging box. Left at the
# defaults, both environments write to db 0 under the same prefix: staging's cache flush clears
# production's, and the two SHARE Cache::lock() names — so staging's billing run can hold the lock
# that stops production double-billing, and neither box shows an error. Set all three per env.
#   prod:     REDIS_PREFIX=atr_p_   REDIS_DB=0   REDIS_CACHE_DB=2
#   staging:  REDIS_PREFIX=atr_s_   REDIS_DB=1   REDIS_CACHE_DB=3
# REDIS_PREFIX=
# REDIS_DB=0
# REDIS_CACHE_DB=1

# MAIL_MAILER: log (nothing leaves the box) | mailersend (HTTPS API) | smtp
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# MailerSend (mailersend/laravel-driver). Create a sending-scoped token in the
# dashboard (Integrations → API tokens). MAIL_FROM_ADDRESS must be on a VERIFIED
# domain or every send 422s with #MS42207. Verify with:
#   php artisan integrations:check --mail
#   php artisan mail:test you@example.com
MAILERSEND_API_KEY=

# Non-production only: redirect EVERY outgoing email here instead of the real
# recipient (demo data is full of fake @*.test addresses). Ignored in production.
MAIL_ALWAYS_TO=

# S3-compatible object storage. Needed for FILESYSTEM_DISK=s3 and for the off-box backup copy
# (BACKUP_DISKS="backups,s3"). NOT used in phase 1, where uploads and archives stay on the box's
# own disk — see INFRASTRUCTURE.md §2. Two things to know before switching it on:
#   - the driver is NOT installed: `composer require league/flysystem-aws-s3-v3` first, or every
#     write to the disk throws rather than falling back to local.
#   - AWS_ENDPOINT is what makes a NON-Amazon provider work (Hetzner, Backblaze B2, Cloudflare R2,
#     DigitalOcean Spaces). Unset, the SDK builds an amazonaws.com hostname from the region and the
#     bucket, so credentials that are perfectly valid fail as though they were wrong.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# AWS_ENDPOINT=https://fsn1.your-objectstorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Integration toggles — flip to true once credentials are wired.
# When false, the corresponding action button is hidden in the UI.
PAYMOB_ENABLED=false

# Owner portal (/owner panel). Off = panel + landing-page card hidden.

# ── Backups (spatie/laravel-backup) ──────────────────────────────────────────
# Runs nightly from the SCHEDULER (routes/console.php), not from CI.
#
# BACKUP_DISKS   destinations, comma-separated. Defaults to the local `backups`
#                disk. A single copy on the same box as the database is NOT a
#                backup — it dies with the box. Add the off-site copy in
#                production: BACKUP_DISKS="backups,s3"
# BACKUP_ARCHIVE_PASSWORD
#                encrypts the archive. An archive holds a full DB dump: tenant
#                tax cards, signed leases, every money record. Set this before
#                any copy leaves the box. EMPTY means no encryption — and it has
#                to be coerced to null in config/backup.php to mean that, because
#                spatie enables AES on any non-null value and libzip then refuses
#                the archive at close(), writing NOTHING. See that file's comment.
# BACKUP_ALERT_EMAIL
#                where failure + unhealthy-backup mail goes. Unset = no mail is
#                sent (the app still boots); `backup:monitor` remains the check
#                that a backup exists and is recent.
# ── Operational notifications (Discord) ──────────────────────────────────────
# One webhook for status alerts. EMPTY = nothing is posted and nothing fails —
# no webhook, no attempt, so the test suite and an unconfigured box stay silent.
#
# It feeds two things:
#   - `atriom:notify-status` (scheduled, every 15 min) posts ONLY when the set of
#     failing atriom:health rows CHANGES, in either direction. Not on every run:
#     a correct staging box is permanently degraded by design, and an alert that
#     fires every quarter-hour about nothing is one nobody reads — including the
#     production alert beside it.
#   - spatie/laravel-backup failure notifications, on its native discord channel.
#     Set BACKUP_DISCORD_WEBHOOK_URL to send those somewhere else instead.
#
# Name the environment in DISCORD_USERNAME, or an alert gets read as production.
DISCORD_WEBHOOK_URL=
# DISCORD_USERNAME="Atriom staging"
# BACKUP_DISCORD_WEBHOOK_URL=

BACKUP_DISKS=backups
BACKUP_ARCHIVE_PASSWORD=
BACKUP_ALERT_EMAIL=
BACKUP_MAX_STORAGE_MB=5000

# ── Health check (/health + `php artisan atriom:health`) ─────────────────────
# Point an EXTERNAL uptime monitor at https://<host>/health. External matters:
# every scheduled monitor (backup:monitor included) can only report a problem
# while the scheduler is alive, so none of them can report that the scheduler
# has STOPPED — and a dead cron silently takes billing, GL sync and the nightly
# backup with it.
#
# 200 = healthy, 503 = something is wrong. Anonymous callers get status only;
# HEALTH_TOKEN unlocks which check failed and why (?token= or X-Health-Token).
# Leave HEALTH_TOKEN unset and detail is never exposed.
HEALTH_TOKEN=
HEALTH_MAX_SCHEDULER_AGE=300
HEALTH_MAX_BACKUP_AGE_HOURS=48
HEALTH_MAX_FAILED_JOBS=0
HEALTH_MAX_PENDING_JOBS=500

# ---------------------------------------------------------------------------
# THE ASSISTANT'S LANGUAGE-MODEL TIER (optional, and OFF)
# ---------------------------------------------------------------------------
# "Ask Atriom" works completely without any of this: it finds the screen, the report, the record or
# the handbook section and shows it, at no cost and with nothing leaving the server. Everything
# below only adds a two-to-four sentence answer WRITTEN FROM what was already found — it never
# chooses what to look at, and it is never asked to compute a figure.
#
# Leave ASSISTANT_DRIVER=none and nothing is sent anywhere and nothing is billed.
#
# Turning it on costs roughly $0.006 a question — about 200 EGP a month for an office of fifteen.
# The ceiling is a hard wall checked BEFORE every call, and spend is derived from the tokens
# recorded on each question, so it survives a cache flush and can be audited on
# /admin/assistant-questions, which also shows the month to date.
ASSISTANT_DRIVER=none

# --- Option A: FREE. Google Gemini (no credit card, ~1,500 requests/day) --------------------
# Get a key at https://aistudio.google.com/apikey, then uncomment these four lines.
# Groq, OpenRouter or a local Ollama differ only in BASE_URL and MODEL.
# ASSISTANT_DRIVER=openai_compatible
# ASSISTANT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ASSISTANT_API_KEY=
# ASSISTANT_MODEL=gemini-flash-lite-latest
# On a free tier there is no bill to cap, so the ceiling is switched off by zeroing the rates:
# ASSISTANT_RATE_INPUT=0
# ASSISTANT_RATE_OUTPUT=0

# --- Option B: PAID. Claude — the model this system was prompted against -------------------
# ASSISTANT_DRIVER=anthropic
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-4-5
# ASSISTANT_MONTHLY_CEILING_USD=10

# Index the DEVELOPER documentation too (docs/modules — registries, invariants, class names).
# Off by default: it answers an operator's business question with an implementation. Switch it on
# for a technical demo, then run `php artisan atriom:rebuild-assistant-index`.
# ASSISTANT_INDEX_TECHNICAL_DOCS=true

# ASSISTANT_CACHE_HOURS=168
